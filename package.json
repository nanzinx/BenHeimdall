{
  "name": "benheimdall",
  "private": true,
  "version": "0.1.0",
  "description": "Painel de monitoramento em tempo real do call center da Benconsig",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,yellow \"pnpm --filter @benheimdall/server dev\" \"pnpm --filter @benheimdall/web dev\"",
    "build": "pnpm -r build",
    "start": "pnpm --filter @benheimdall/server start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:tunel": "cloudflared tunnel --no-autoupdate --url http://localhost:5173",
    "prod:tunel": "cloudflared tunnel --no-autoupdate --url http://localhost:3001"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.7"
  }
}
