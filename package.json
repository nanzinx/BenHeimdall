{
  "name": "benheimdall",
  "private": true,
  "version": "0.1.0",
  "description": "Painel de monitoramento em tempo real do call center da Benconsig",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,yellow \"npm run dev -w @benheimdall/server\" \"npm run dev -w @benheimdall/web\"",
    "build": "npm run build -w @benheimdall/server -w @benheimdall/web",
    "start": "npm run start -w @benheimdall/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pm2:iniciar": "pm2 startOrRestart ecosystem.config.cjs --env production",
    "pm2:parar": "pm2 stop benheimdall",
    "pm2:logs": "pm2 logs benheimdall --lines 40",
    "servico:instalar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/instalar-servico.ps1",
    "servico:verificar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/verificar-servico.ps1",
    "servico:desinstalar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/desinstalar-servico.ps1",
    "tunel:instalar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/instalar-tunel.ps1",
    "dev:tunel": "cloudflared tunnel --no-autoupdate --url http://localhost:5180",
    "prod:tunel": "cloudflared tunnel --no-autoupdate --url http://localhost:3020"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "pm2": "^7.0.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "vite": "^6.4.1"
  }
}
