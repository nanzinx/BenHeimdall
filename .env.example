# Porta do backend. O BenURA usa 3000, 3001, 3002, 3003 e 3010 no mesmo servidor.
# Em desenvolvimento, o Vite (porta 5180) repassa /api e /socket.io para cá.
PORT=3020
NODE_ENV=development

# --- Argus (Discadora) ---
# mock = simulada (para testar telas); real = a Argus de verdade.
# Para sair da simulação: ARGUS_MODE=real e o ARGUS_TOKEN (o MESMO do .env do BenURA).
ARGUS_MODE=mock
ARGUS_TOKEN=
ARGUS_BASE_URL=https://argus.app.br/apiargus/cmd
ARGUS_TIMEOUT_MS=5000
# Quantos /statusoperador ao mesmo tempo (um por agente, a cada POLL_MS).
ARGUS_CONCORRENCIA=10
# Só operadores destas campanhas (ids, por vírgula). Vazio = todos os operadores humanos ativos.
ARGUS_CAMPANHAS_IDS=
# Pausa por limite de requisições (HTTP 429) compartilhada com o BenURA: aponte para o mesmo
# arquivo dele (ARGUS_PAUSA_FILE do BenURA; padrão: <pasta do BenURA>\argus-pausa.json).
ARGUS_PAUSA_FILE=
# Textos de status da Argus (mesmas variáveis e padrões do BenURA). Vazio = padrão.
# STATUS_LIVRE=livre,disponivel
# STATUS_ATENDIMENTO=atendimento,em atendimento,falando,conversa
# STATUS_POS_ATENDIMENTO=tabulando,tabulacao,pos atendimento
# STATUS_OFFLINE=deslogado,offline,desconectado
# Equipes (supervisor → número) e baias (ramal → lado/posição). Opcionais: veja os .example.json.
EQUIPES_FILE=config/equipes.json
BAIAS_FILE=config/baias.json
# Só no modo mock: começa com a Argus "fora do ar" para testar a queda.
ARGUS_MOCK_FALHA=false

# Intervalo do laço de leitura da Argus, em milissegundos.
POLL_MS=3000

# Banco SQLite (caminho relativo à raiz do projeto).
DB_PATH=data/benheimdall.db

# Segredo usado para assinar o cookie de sessão. Obrigatório em produção (mínimo 32 caracteres).
SESSION_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
# Minutos sem uso até a sessão expirar (admin e supervisor).
SESSAO_MIN=15

# IPs de onde o perfil tv pode entrar, separados por vírgula (aceita CIDR). Vazio = nenhum.
# TODO: confirmar o PC e o IP da Tela TV.
TV_ALLOWED_IPS=127.0.0.1,::1

# Primeiro admin, criado na primeira execução (troca de senha obrigatória no primeiro acesso).
# Todos os logins são por e-mail.
ADMIN_USER=renan.leite@benconsig.com
ADMIN_SENHA_INICIAL=troque-no-primeiro-acesso

# IPs/faixas que podem acessar o sistema (páginas, API e tempo real), por vírgula.
# Aceita IPv4, IPv6 e CIDR. A própria máquina (127.0.0.1/::1) sempre entra. Vazio = sem restrição.
IPS_PERMITIDOS=2804:431:80f7:7700::/48,2804:1b3:a5e7:c3c7::/48,201.93.163.133,2804:1b3:a5e7:2c83::/48,201.93.159.169,2804:1b3:a5e7:8e38::/48

# Proxies confiáveis para descobrir o IP real do cliente (regra da TV e log de acessos).
#   loopback             → Vite em dev e cloudflared/nginx rodando na mesma máquina (padrão seguro)
#   loopback,uniquelocal → cloudflared em outro container da mesma rede Docker
#   vazio                → desligado (o IP visto é o de quem conecta direto)
TRUST_PROXY=loopback

# Só em dev: domínios extras liberados no Vite (ex.: túnel nomeado do Cloudflare), por vírgula.
# Os túneis rápidos (*.trycloudflare.com) já são liberados.
DEV_ALLOWED_HOSTS=

# Só no Docker Compose com o perfil "cloudflare": token do túnel criado no painel Zero Trust.
CLOUDFLARE_TUNNEL_TOKEN=

# Só no docker compose: endereço onde a porta é publicada (127.0.0.1 = só no servidor).
BIND_ADDR=127.0.0.1

# Nível de log do pino: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info
